{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.iacgenius.com/v1/human-interrupt-packet.schema.json",
  "title": "HumanInterruptPacket",
  "description": "A blocking question for the human. Created by LangGraph, persisted with the checkpoint so it survives refresh; resume restores the checkpoint and starts a NEW worker run. Never retried automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_type", "mission_id", "created_at", "provenance",
    "interrupt_id", "question", "blocking"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "packet_type": { "const": "human_interrupt" },
    "mission_id": { "type": "string" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "provenance": { "$ref": "common.schema.json#/$defs/Provenance" },
    "interrupt_id": { "type": "string" },
    "question": { "type": "string", "description": "ONE focused question." },
    "context": { "type": "string", "description": "Non-secret context the user needs to answer." },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "blocking": { "const": true },
    "resolved_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "response": { "type": "string" }
  }
}
