  "cards": [
    { "dot": "cyan", "title": "The split that matters", "items": ["The LLM proposes code; a deterministic, credential-less desk decides what is true", "validate + secret_scan are hard gates; tflint / checkov / fmt are soft, human decisions", "A scanner that did not run is NOT_RUN, never PASS"] },
    { "dot": "emerald", "title": "Filesystem is the source of truth", "items": ["A mission is its folder: .tf code plus work/ provenance (ledger, freeze hash, evidence, acceptances)", "A lost folder is forgotten, not kept as a stale database record", "Optional S3 sync mirrors only changed files every 5 min and restores on boot"] },
    { "dot": "violet", "title": "Humans own the decisions", "items": ["Costly or irreversible choices are asked, then frozen into one build-sheet hash", "Soft security findings are accepted by name with a reason, never silently passed", "Delivery needs a named approval; the PR body is the ledger and the commit is read back"] },
    { "dot": "amber", "title": "Consume the ecosystem, do not rebuild", "items": ["Read-only guidance comes from Hermes MCPs (terraform-registry, aws-knowledge, DeepWiki)", "Generation checks every argument against the real provider schema (OKF cache)", "Remembered conventions (region, owner tag) resolve from knowledge cards across missions"] }
